# Ambiente (development | production)
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mood_sharing?retryWrites=true&w=majority

# JWT (obrigatórios em produção)
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (origens separadas por vírgula)
CORS_ORIGINS=https://your-app-domain.com

# Netlify Blobs (para deploy serverless)
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# Firebase Admin (caminho para service account ou env vars)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
