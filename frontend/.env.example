# Variáveis de ambiente de BUILD (lidas por app.config.js).
# Em produção, configure-as como EAS Secrets ou no bloco "env" de cada perfil em eas.json.
# Os valores abaixo são apenas exemplos.

# URL da API Backend
API_BASE_URL=https://your-api-domain.com/api

# Expo Project ID (para notificações push)
EXPO_PROJECT_ID=your-expo-project-id

# Firebase (somente se o SDK web do Firebase for usado no app)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=000000000000
