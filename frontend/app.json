{
  "expo": {
    "name": "Mood Sharing",
    "slug": "mood-sharing-app",
    "version": "3.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moodsharing.app",
      "buildNumber": "3",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para mostrar quando você está próximo do seu parceiro",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Precisamos da sua localização em background para detectar proximidade",
        "NSLocationAlwaysUsageDescription": "Precisamos da sua localização em background para detectar proximidade",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0d1117"
      },
      "versionCode": 4,
      "package": "com.moodsharing.app",
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Precisamos da sua localização em background para detectar proximidade"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acessar sua galeria para atualizar sua foto"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir uso do Face ID para desbloquear o app"
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "android": {
            "googleServicesFile": "./android/app/google-services.json"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0d1117",
          "mode": "production"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "API_BASE_URL": "https://moodsharin.netlify.app/api",
      "eas": {
        "projectId": "d4ce3370-dfaa-41c0-a794-12df28a9fc91"
      }
    },
    "owner": "seekds"
  }
}
