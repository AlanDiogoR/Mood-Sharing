{
  "expo": {
    "name": "Mood Sharing",
    "slug": "mood-sharing-app",
    "version": "2.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moodsharing.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para mostrar quando você está próximo do seu parceiro",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Precisamos da sua localização em background para detectar proximidade",
        "NSLocationAlwaysUsageDescription": "Precisamos da sua localização em background para detectar proximidade"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "versionCode": 2,
      "package": "com.moodsharing.app",
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Precisamos da sua localização em background para detectar proximidade"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acessar sua galeria para atualizar sua foto"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir uso do Face ID para desbloquear o app"
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "android": {
            "googleServicesFile": "./android/app/google-services.json"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0d1117",
          "mode": "production"
        }
      ]
    ],
